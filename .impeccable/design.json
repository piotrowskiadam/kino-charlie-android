  "components": [
    {
      "name": "Screening time",
      "kind": "button",
      "refersTo": "screening-button",
      "description": "Exact screening selector under a visible room name, with room-aware accessible text. Illustrative native-to-web panel translation; see DESIGN.md.",
      "html": "<div><p class=\"ds-room\">Sala Studyjna</p><button class=\"ds-time\" aria-label=\"18:15, sala Studyjna\">18:15</button></div>",
      "css": ".ds-time{color:#000000;background:transparent;border:1px solid #000000;border-radius:10px;padding:8px 12px;min-height:48px;font:600 14px sans-serif}.ds-time:active{background:#F2DDE0}.ds-time:focus-visible,.ds-checkout:focus-visible,.ds-day:focus-visible,.ds-nav button:focus-visible{outline:2px solid #000000;outline-offset:3px}.ds-room{margin:8px 0 4px;color:#000000;font:600 14px sans-serif}"
    },
    {
      "name": "Checkout",
      "kind": "button",
      "refersTo": "checkout-button",
      "description": "Source checkout action. Illustrative native-to-web panel translation; see DESIGN.md.",
      "html": "<button class=\"ds-checkout\">Przejdź do kasy kina</button>",
      "css": ".ds-checkout{background:#742D3A;color:#fff;border:0;border-radius:999px;min-height:52px;padding:12px 24px;font:500 14px sans-serif}.ds-checkout:active{background:#52212C}.ds-checkout:disabled{opacity:.38}.ds-time:focus-visible,.ds-checkout:focus-visible,.ds-day:focus-visible,.ds-nav button:focus-visible{outline:2px solid #000000;outline-offset:3px}"
    },
    {
      "name": "Day selection",
      "kind": "chip",
      "refersTo": "date-selected",
      "description": "Selected and idle localized day tiles. Illustrative native-to-web panel translation; see DESIGN.md.",
      "html": "<div class=\"ds-days\"><button class=\"ds-day ds-selected\" aria-pressed=\"true\">Dziś<strong>30</strong></button><button class=\"ds-day\" aria-pressed=\"false\">Jutro<strong>31</strong></button></div>",
      "css": ".ds-days{display:flex;gap:8px}.ds-day{min-width:60px;padding:10px 12px;border:0;border-radius:12px;background:#F5EFE6;color:#000000;font:500 12px sans-serif}.ds-day strong{display:block;font:600 22px/29px sans-serif}.ds-selected{background:#742D3A;color:#fff}.ds-day:active{filter:brightness(.95)}.ds-time:focus-visible,.ds-checkout:focus-visible,.ds-day:focus-visible,.ds-nav button:focus-visible{outline:2px solid #000000;outline-offset:3px}"
    },
    {
      "name": "Search",
      "kind": "input",
      "refersTo": "search",
      "description": "Outlined title search with explicit Polish label. Illustrative native-to-web panel translation; see DESIGN.md.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"m15 15 5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><input aria-label=\"Szukaj filmu\" placeholder=\"Szukaj filmu\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:12px;border:1px solid #84726B;border-radius:14px;padding:16px;color:#000000;background:#F8F4EC}.ds-search input{border:0;background:transparent;color:#000000;font:16px sans-serif;min-width:0;outline:none}.ds-search:focus-within{border:2px solid #000000;padding:15px}"
    },
    {
      "name": "Program row",
      "kind": "custom",
      "refersTo": "poster",
      "description": "Continuous row with visible room groups and source-art placeholder, never fabricated art. Illustrative native-to-web panel translation; see DESIGN.md.",
      "html": "<article class=\"ds-film\"><div class=\"ds-poster\" aria-label=\"Brak plakatu\"><svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 3h16v18H4zM8 3v18M16 3v18M4 8h4M4 16h4M16 8h4M16 16h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></div><div><h3 class=\"ds-title\">Tytuł filmu</h3><p class=\"ds-meta\">Dramat · 120 min</p><p class=\"ds-room\">Sala Studyjna</p><button class=\"ds-time\" aria-label=\"18:15, sala Studyjna\">18:15</button></div></article>",
      "css": ".ds-film{display:flex;gap:14px;padding:14px 0;border-top:1px solid #DCD0C7;background:#F8F4EC;color:#000000}.ds-poster{width:82px;height:123px;flex-shrink:0;border-radius:8px;background:#EDE5DB;color:#000000;display:flex;align-items:center;justify-content:center}.ds-title{margin:0;color:#000000;font:600 18px/25px Literata,serif}.ds-meta{margin:3px 0 4px;color:#000000;font:14px sans-serif}.ds-time{color:#000000;background:transparent;border:1px solid #000000;border-radius:10px;padding:8px 12px;min-height:48px;font:600 14px sans-serif}.ds-time:active{background:#F2DDE0}.ds-time:focus-visible,.ds-checkout:focus-visible,.ds-day:focus-visible,.ds-nav button:focus-visible{outline:2px solid #000000;outline-offset:3px}.ds-room{margin:8px 0 4px;color:#000000;font:600 14px sans-serif}"
    },
    {
      "name": "Compact navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Three labeled destinations; panel uses text to avoid substituting icon assets. Illustrative native-to-web panel translation; see DESIGN.md.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Nawigacja\"><button aria-current=\"page\">Repertuar</button><button>Zapisane</button><button>Kino</button></nav>",
      "css": ".ds-nav{display:flex;gap:8px;background:#F5EFE6;padding:12px}.ds-nav button{flex:1;min-height:48px;border:0;border-radius:20px;background:transparent;color:#000000;font:500 12px sans-serif}.ds-nav button[aria-current]{background:#742D3A;color:#FFFFFF}.ds-nav button:active{background:#EDE5DB}.ds-time:focus-visible,.ds-checkout:focus-visible,.ds-day:focus-visible,.ds-nav button:focus-visible{outline:2px solid #000000;outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Pocket cinema program",
    "overview": "Charlie uses the approved pocket cinema program: literary headings, warm paper surfaces, restrained burgundy accents and native Android controls. One continuous sheet keeps complete film titles and exact screening times easy to scan. It is a native Kotlin/Jetpack Compose Material 3 implementation; dp and sp in the frontmatter are Android units, not CSS pixels.\n\nThe user selected variant A in `docs/design/approved-mvp-variants.png`. The shipped interface adapts that board to Android. Actual source images replace illustrative decision-board art; no fabricated film artwork ships.\n\nThe user refined the palette to monochrome text and true-black OLED dark surfaces; burgundy survives in selected controls.",
    "keyCharacteristics": [
      "Literata headings paired with native sans controls and numerals.",
      "Continuous program rows, restrained separators and a 2:3 poster silhouette.",
      "Truthful cached status, complete titles and visibly named room groups with directly actionable screening times.",
      "System dark theme, font scaling, Android Back and adaptive navigation.",
      "Positive black cinema logo on a white bordered plaque in dark mode, a black bowler-hat launcher icon with a narrow toothbrush moustache, and a brief cache-aware first-run welcome."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Use primary-container/on-primary-container for selected days, filled actions and navigation indicators; ordinary foregrounds are pure black or white.",
        "section": "colors"
      },
      {
        "name": "The Complete Title Rule",
        "body": "Critical film names wrap; the implementation sets no title truncation or maximum line count.",
        "section": "typography"
      },
      {
        "name": "The Continuous Sheet Rule",
        "body": "Separate films with outline-variant dividers rather than nesting each film in a raised card.",
        "section": "elevation"
      },
      {
        "name": "The Room Rule",
        "body": "Show the room name before the user chooses a screening time, on both schedule and saved-film lists. Repeat it prominently in film details and the screening sheet; equal times in different rooms remain separate choices.",
        "section": "layout"
      },
      {
        "name": "The First Run Rule",
        "body": "Read cache before deciding on welcome. Prepare only until today is durable, without an artificial delay; continue future days in the background. Use the official mark, honest indeterminate progress and actionable first-use failure.",
        "section": "layout"
      },
      {
        "name": "The Positive Logo Rule",
        "body": "Keep the cinema mark black in every theme. On dark surfaces use a white plaque with 6dp corners, 1dp outline-variant border and 4dp padding; preserve the face polarity and artwork aspect ratio.",
        "section": "colors"
      },
      {
        "name": "The Quiet Update Rule",
        "body": "Keep update checks separate from the schedule. In Kino show native byte-based download progress, cancel and retry. A verified ready APK has an offline-capable install button; Android owns source permission and installation confirmation. No browser download or forced modal.",
        "section": "layout"
      },
      {
        "name": "The OLED Rule",
        "body": "Ordinary text is #000000 in light mode and #FFFFFF in dark mode. Dark neutral surfaces, window background and system navigation are #000000; preserve colored selections, artwork and the positive logo plaque.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use Literata for the recorded heading roles and native sans for body, controls and date numerals.",
      "Do preserve full Polish titles, localized dates and explicit action labels.",
      "Do expose room names before time selection, preserve all room groups in saved-film previews and repeat the selected room before checkout.",
      "Do keep source imagery at a 2:3 ratio and use the verified ticket image when the primary poster fails.",
      "Do retain 8dp spacing between wrapped screening buttons and a minimum 48dp screening target.",
      "Do distinguish unpublished days, empty search, first download, cached content and connection errors."
    ],
    "donts": [
      "Don't substitute invented artwork, screenings, prices or availability for missing source data.",
      "Don't promote the decision board's illustrative imagery into production assets.",
      "Don't add ornamental shadows, gradients or entrance animations to the continuous program sheet.",
      "Don't truncate critical film names or make checkout look like an in-app payment flow."
    ]
  }
}
