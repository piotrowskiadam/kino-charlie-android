      "css": ".ds-time{color:#742D3A;background:transparent;border:1px solid #742D3A;border-radius:10px;padding:8px 12px;min-height:48px;font:600 14px sans-serif}.ds-time:active{background:#F2DDE0}.ds-time:focus-visible,.ds-checkout:focus-visible,.ds-day:focus-visible,.ds-nav button:focus-visible{outline:2px solid #742D3A;outline-offset:3px}.ds-room{margin:8px 0 4px;color:#28201F;font:600 14px sans-serif}"
    },
